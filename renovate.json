{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Tagged by the release workflow",
      "matchPackageNames": [
        "ghcr.io/whyredfire/redoost-api",
        "ghcr.io/whyredfire/redoost-frontend"
      ],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "Docker images"
    },
    {
      "matchManagers": ["cargo"],
      "groupName": "Rust crates"
    },
    {
      "matchManagers": ["npm", "bun"],
      "groupName": "JavaScript packages"
    },
    {
      "description": "Keep Bun in the Dockerfiles and CI on one version",
      "matchPackageNames": ["oven/bun", "bun"],
      "groupName": "Bun"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Last, so it overrides the groups above: one PR for all non-major updates; majors stay separate",
      "matchUpdateTypes": ["minor", "patch", "digest", "lockFileMaintenance"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    }
  ]
}
