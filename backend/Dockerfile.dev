FROM rust:1.100-slim-trixie@sha256:3b199fd6db7d709274df56565b8f4003f9e30d7bfcff9d53148c86053b7855e2

RUN cargo install cargo-watch --locked

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY migrations ./migrations
COPY tests ./tests
# Installed for the one-off init and migrate services; the build also seeds the
# api service's target volume, so its first cargo watch run is incremental
RUN cargo build --locked \
    && cp target/debug/redoost-api /usr/local/bin/

CMD ["cargo", "watch", "-x", "run -- serve"]
