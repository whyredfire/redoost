FROM ghcr.io/astral-sh/uv:python3.15-trixie-slim@sha256:1017e944d8b320412287a572b8221cda45742348d0feb99e500f1f4c4b019206

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1

COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --locked

COPY src ./src
COPY migrations ./migrations
COPY scripts ./scripts
COPY tests ./tests

CMD ["uv", "run", "-m", "src.main"]
